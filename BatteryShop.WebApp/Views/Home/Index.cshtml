@{
    ViewBag.Title = "Home Page";
}

<div class="hero-panel">
    <h1>Power every drive with the right battery.</h1>
    <p class="lead">Battery Store helps teams and customers quickly discover dependable automotive, inverter, and backup power options in a clean, responsive catalog experience.</p>
    <div class="hero-actions">
        @Html.ActionLink("Browse inventory", "ItemList", "Item", null, new { @class = "btn btn-lg btn-hero-primary" })
        @Html.ActionLink("Talk to our team", "Contact", "Home", null, new { @class = "btn btn-lg btn-hero-secondary" })
    </div>
</div>

<div class="row stats-grid">
    <div class="col-md-4">
        <div class="stat-card">
            <strong>Fast</strong>
            <span>Responsive product browsing with simple filters and paginated results.</span>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <strong>Reliable</strong>
            <span>Built to surface inventory details clearly for sales, support, and operations.</span>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <strong>Professional</strong>
            <span>A modern visual refresh that works smoothly across desktop and mobile screens.</span>
        </div>
    </div>
</div>

<div class="section-heading">
    <h2>Why teams choose Battery Store</h2>
    <p>Everything important is one click away—from inventory search to product support and business contact details.</p>
</div>

<div class="row">
    <div class="col-md-4">
        <div class="feature-card">
            <h3>Inventory search</h3>
            <p>Filter by serial number, brand, and page size to quickly find the batteries you need.</p>
            @Html.ActionLink("Open catalog", "ItemList", "Item", null, new { @class = "btn btn-primary" })
        </div>
    </div>
    <div class="col-md-4">
        <div class="feature-card">
            <h3>Business-ready details</h3>
            <p>Present item IDs, transaction references, and brand data in a clean table designed for quick scanning.</p>
            @Html.ActionLink("Learn about us", "About", "Home", null, new { @class = "btn btn-default" })
        </div>
    </div>
    <div class="col-md-4">
        <div class="feature-card">
            <h3>Responsive by default</h3>
            <p>Improved spacing, cards, and controls make the interface easier to use on phones, tablets, and desktops.</p>
            @Html.ActionLink("Contact sales", "Contact", "Home", null, new { @class = "btn btn-default" })
        </div>
    </div>
</div>